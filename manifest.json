{
  "manifest_version": 3,
  "name": "Mark Viewer",
  "version": "1.0.0",
  "description": "Renders local Markdown files as beautifully formatted HTML, with a file tree for browsing local folders.",
  "icons": {
    "16": "src/icons/icon-16.png",
    "48": "src/icons/icon-48.png",
    "128": "src/icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background/service-worker.ts"
  },
  "content_scripts": [
    {
      "matches": ["file:///*"],
      "include_globs": [
        "*://*/*.md",
        "*://*/*.md#*",
        "*://*/*.markdown",
        "*://*/*.markdown#*",
        "file:///",
        "file:///*/"
      ],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    },
    {
      "matches": ["file:///*"],
      "exclude_globs": [
        "*://*/*.md",
        "*://*/*.md#*",
        "*://*/*.markdown",
        "*://*/*.markdown#*",
        "file:///",
        "file:///*/"
      ],
      "js": ["src/content/redirect.ts"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/viewer/viewer.html"],
      "matches": ["file:///*"]
    }
  ],
  "action": {
    "default_title": "Toggle Markdown View"
  },
  "commands": {
    "toggle-markdown": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "Command+Shift+M"
      },
      "description": "Toggle between raw and rendered Markdown"
    }
  },
  "permissions": ["activeTab", "storage"]
}
